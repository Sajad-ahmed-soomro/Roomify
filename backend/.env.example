INTERNAL_API_KEY=  # openssl rand -hex 32

# Claude — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# "sd" = Stable Diffusion in this process, "remote" = call worker.py, "demo" = colour-graded preview
IMAGE_ENGINE=sd
# Used by worker.py, and by the API when IMAGE_ENGINE=remote
RENDER_URL=http://127.0.0.1:8001
RENDER_KEY=  # openssl rand -hex 32

# Per-user limit (0 = unlimited) and emails exempt from it
MAX_DESIGNS_PER_USER=2
UNLIMITED_EMAILS=you@example.com

# Image storage: "db" (default) or "s3" (Google Cloud Storage / R2 / S3)
IMAGE_STORAGE=db
# S3_BUCKET=
# S3_ENDPOINT_URL=https://storage.googleapis.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Neon connection string in production, e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
